# ── Search ────────────────────────────────────────────────────────────
SERPER_API_KEY=

# ── LLM Provider ──────────────────────────────────────────────────────
LLM_PROVIDER=         # "groq" | "ollama" | "none" — auto-detected if unset

# ── Groq (recommended — free, fast, no GPU) ───────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local fallback) ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Supabase ──────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # Keep secret — never expose to browser

# ── VPS Agent Server ──────────────────────────────────────────────────
# Set in production when deploying to Vercel + VPS
AGENT_SERVER_URL=             # e.g. https://agents.yourdomain.com
AGENT_SECRET=                 # Random string — shared between Vercel and VPS
AGENT_PORT=4000               # VPS server port
FRONTEND_URL=                 # Your Vercel URL for CORS

# ── Google OAuth (optional — enable in Supabase Dashboard first) ───────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Add to Supabase: Dashboard → Authentication → Providers → Google

# ── Political research (Round 2 v2) ────────────────────────────────────
# All free. Missing any one just means that source's data is skipped —
# no research run fails outright for lacking a political-research key.
OPENFEC_API_KEY=               # api.data.gov signup — campaign finance (FEC)
CONGRESS_API_KEY=              # api.congress.gov signup — voting/sponsorship
LEGISCAN_API_KEY=              # legiscan.com/legiscan/register — state legislators

# ── OpenCorporates (Round 3 — Jackal Person Research) ──────────────────
# Optional. Works keyless at low volume; set this to raise the rate limit.
OPENCORPORATES_API_TOKEN=

# ── MuckRock (Round 3 — Jackal builds) ──────────────────────────────────
# Your regular MuckRock account login — NOT an access/refresh token.
# Access tokens expire after 5 minutes and refresh tokens rotate on each
# use, so there's no stable token to store here; the agent logs in with
# these credentials and caches a short-lived access token in memory.
MUCKROCK_USERNAME=
MUCKROCK_PASSWORD=
