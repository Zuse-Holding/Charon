# ── Search ────────────────────────────────────────────────────────────
SERPER_API_KEY=

# ── LLM Provider ──────────────────────────────────────────────────────
LLM_PROVIDER=         # "groq" | "ollama" | "none" — auto-detected if unset

# ── OpenRouter (checked first if set — see src/lib/llm.ts) ────────────
# OPENROUTER_API_KEY_2 is optional — a second account's key. Requests
# round-robin between the two and retry on the other key on a 429, so
# their free-tier rate limits stack instead of sharing one bucket.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# ── Groq (fallback if OpenRouter isn't set/fails — free, fast, no GPU) ─
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local fallback) ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Supabase ──────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # Keep secret — never expose to browser

# ── VPS Agent Server ──────────────────────────────────────────────────
# Set in production when deploying to Vercel + VPS
AGENT_SERVER_URL=             # e.g. https://agents.yourdomain.com
AGENT_SECRET=                 # Random string — shared between Vercel and VPS
AGENT_PORT=4000               # VPS server port
FRONTEND_URL=                 # Your Vercel URL for CORS

# ── Google OAuth (optional — enable in Supabase Dashboard first) ───────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Add to Supabase: Dashboard → Authentication → Providers → Google

# ── Political research (Round 2 v2) ────────────────────────────────────
# All free. Missing any one just means that source's data is skipped —
# no research run fails outright for lacking a political-research key.
OPENFEC_API_KEY=               # api.data.gov signup — campaign finance (FEC)
CONGRESS_API_KEY=              # api.congress.gov signup — voting/sponsorship
LEGISCAN_API_KEY=              # legiscan.com/legiscan/register — state legislators

# ── OpenCorporates (Round 3 — Jackal Person Research) ──────────────────
# Optional. Works keyless at low volume; set this to raise the rate limit.
OPENCORPORATES_API_TOKEN=

# ── Public-record fusion (7/20) ─────────────────────────────────────────
# Sanctions screening only — the other four new sources (Wayback,
# ProPublica Nonprofit, LittleSis, ICIJ Offshore Leaks) are keyless.
# Free: sign in at developer.trade.gov → Products → "Data Services
# Platform APIs" → Subscribe → copy the Primary key from your Profile page.
TRADE_GOV_API_KEY=

# ── Creator / market-signal research (general v1) ──────────────────────
# Free — console.cloud.google.com → enable "YouTube Data API v3" → create
# an API key. Missing this just means the YouTube Stats section of a
# creator report comes back empty; the rest of the report (bio, trend,
# chatter) still runs. Google Trends needs no key (undocumented public
# endpoint) — see src/agents/creator-signal-agent.
YOUTUBE_API_KEY=

# ── Photo Identity Verification (Charon-only, src/agents/face-verify-agent) ─
# AWS Rekognition CompareFaces — 1:1 face comparison between two analyst-
# uploaded photos. IAM user/role should be scoped to rekognition:CompareFaces
# only (see server/agent-server.ts's doc comment on /person-research/verify-photo
# for why this stays narrow). Missing these just means that one Charon tool
# 500s when used; nothing else in the app depends on them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Stripe billing (docs/stripe-integration-plan.md) ────────────────────
# Test mode while building: dashboard.stripe.com (toggle "Test mode") →
# Developers → API keys. Price IDs come from Product catalog → each plan's
# Price → copy the price_... id (NOT the product id). Webhook secret: for
# local testing use the Stripe CLI (`stripe listen --forward-to
# localhost:3000/api/stripe/webhook`), which prints a whsec_... value —
# don't create a dashboard webhook endpoint until deploying for real.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
# No Team price — Team isn't sold via Checkout (see docs/stripe-integration-plan.md)

# Pro fair-use soft caps (task 1.6) — optional, default to 300/50 if unset.
PRO_MONTHLY_RESEARCH_LIMIT=
PRO_MONTHLY_DEEP_DIVE_LIMIT=

# ── Rate limiting (task 3.1) — all optional, sensible defaults if unset ─
# Research: per-account hourly throttle (separate from the monthly/lifetime
# quotas in task 1.6 — this is a burst limiter, not a plan entitlement),
# tier-aware, plus a flat per-IP ceiling as defense-in-depth against one IP
# cycling through many accounts. All enforced in server/agent-server.ts.
RATE_LIMIT_FREE_PER_HOUR=
RATE_LIMIT_PAID_PER_HOUR=
RATE_LIMIT_PER_IP_PER_HOUR=
# Auth: per-IP limits on the proxy routes in web/app/api/auth/*
# (signup/signin/reset-password went through our own server instead of
# calling Supabase directly from the browser specifically so these could
# be rate-limited — see web/lib/rate-limit.ts).
RATE_LIMIT_SIGNUP_PER_HOUR=
RATE_LIMIT_SIGNIN_PER_HOUR=
RATE_LIMIT_RESET_PER_HOUR=

# ── Analytics (task 4.1) — optional, everything no-ops without it ──────
# Server-side (agent-server.ts + Next.js API routes) uses POSTHOG_KEY.
# Client-side (pdf_export only — window.print() has no server-side hook)
# needs its own NEXT_PUBLIC_-prefixed copy since Next.js only inlines
# NEXT_PUBLIC_* vars into the browser bundle. Same PostHog project key
# works for both — get it from PostHog → Project Settings → API Keys.
POSTHOG_KEY=
POSTHOG_HOST=                  # defaults to https://us.i.posthog.com if unset
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Transactional email (task 4.2) — optional, no-ops without a key ────
# Welcome, day-7 check-in, and cap-reached emails, all sent from the agent
# server (src/lib/email) — see CHECKLIST.md for why: keeps the actual
# Resend integration and copy in one place instead of duplicated across
# the web app and the daily cron job. resend.com → API Keys → create one.
# Copy lives in src/lib/email/copy.ts — edit that file, not the callers.
RESEND_API_KEY=
EMAIL_FROM=                    # e.g. "Metis <hello@metisanalytic.com>" — defaults to onboarding@resend.dev (Resend's shared test address) if unset, which only delivers to your own Resend account email until a sending domain is verified

# ── MuckRock (Round 3 — Jackal builds) ──────────────────────────────────
# Only path that works: your regular MuckRock account login (NOT an
# access/refresh token pair — those expire in 5 minutes, so there's
# nothing stable to store). MuckRock no longer issues a static/permanent
# API key at all — confirmed by reading their actual source: api_v2's
# FOIA endpoint only accepts a Squarelet-issued JWT (obtained via this
# username/password exchange) or a session cookie, never a static key.
MUCKROCK_USERNAME=
MUCKROCK_PASSWORD=
