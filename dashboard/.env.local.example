# Dashboard (Vercel env) — public, browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by app/api routes. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — the dashboard login (middleware.ts). Required in production:
# a deploy without it shows the login page and lets nobody in. Local dev
# without it stays open. DASHBOARD_SESSION_SECRET is optional; it signs the
# session cookie and defaults to the password.
DASHBOARD_PASSWORD=
# DASHBOARD_SESSION_SECRET=

# Server-only — used by app/api/ops/chat. Read-only conversational chat with
# Selene, no tools/gate involved. Runs on Groq (free tier), same provider as
# agents/selene_chat.py — get a key at console.groq.com.
GROQ_API_KEY=
SELENE_GROQ_MODEL=

# Server-only — used by app/api/ops/alpaca to sync each Trading Bots venture
# bot's orders into the `trades` table. One Alpaca account per bot (each has
# its own key pair) — add _4, _5, ... for more bots, no code change needed.
# Defaults to paper trading; set _BASE_URL to https://api.alpaca.markets
# per-bot (or ALPACA_BASE_URL globally) for a bot trading a live account.
ALPACA_BOT_1_NAME=
ALPACA_BOT_1_KEY_ID=
ALPACA_BOT_1_SECRET=
ALPACA_BOT_2_NAME=
ALPACA_BOT_2_KEY_ID=
ALPACA_BOT_2_SECRET=
ALPACA_BOT_3_NAME=
ALPACA_BOT_3_KEY_ID=
ALPACA_BOT_3_SECRET=

# Server-only — used by app/api/ops/revenue (Metis MRR + last-30-day revenue).
# Create a RESTRICTED key in Stripe (Developers → API keys → Create restricted
# key) with Read on Subscriptions, Invoices, Charges and Products, nothing
# else. A full sk_ key is refused. Tag each Stripe product with metadata
# metis_product = intelligence | diligence | committee (or put the word in
# its name) so revenue lands under the right product.
STRIPE_RESTRICTED_KEY=
