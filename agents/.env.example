# SELENE OS agent — env vars specific to agents/selene.py, agents/mcp_tools.py,
# and agents/selene_chat.py. Supabase project vars (NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) are already in the
# repo root .env.example — reuse those same values here. Python's os.environ
# reads the plain, unprefixed names below (the NEXT_PUBLIC_ prefix is a
# Next.js-only convention; the underlying values are identical):
SUPABASE_URL=                  # same value as NEXT_PUBLIC_SUPABASE_URL above
SUPABASE_SERVICE_ROLE_KEY=     # same value as root .env.example's — keep secret

# agents/selene.py (the cron job runner: inbox/finance/enrichment/brief) runs
# on `claude -p` (headless Claude Code), NOT an API key. On this box, run
# `claude login` once with your Pro/Max subscription and leave it logged in —
# no ANTHROPIC_API_KEY needed, no env var to set here for it. The
# claude_agent_sdk Python package was the original plan but it only
# authenticates via ANTHROPIC_API_KEY or an enterprise cloud credential;
# Anthropic's docs are explicit that third-party products can't run agents on
# a subscription login through that package, so this shells out to the CLI's
# headless mode instead. See agents/selene.py's module docstring.
SELENE_MODEL=sonnet             # short CLI alias, not a full model id
SELENE_BRIEF_MODEL=opus         # heavier model for the weekly brief only

# agents/selene_chat.py (a separate interactive terminal chat loop — not the
# dashboard's chat, not the cron jobs above) runs on Groq/Ollama:
SELENE_PROVIDER=groq           # groq | ollama
GROQ_API_KEY=                  # your existing key; leave unset if using ollama
SELENE_GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_URL=http://localhost:11434/v1
# SELENE_OLLAMA_MODEL=qwen2.5:7b

# Gmail MCP server — NOT YET CONFIGURED. Until GMAIL_MCP_URL is set,
# run_inbox()/run_finance() fail loudly on purpose rather than silently
# no-op. Read-only scopes for v1 (no send scope until the approved-email
# executor ships in Phase 3). Once you add one via `claude mcp add`, also add
# its read-only tool name(s) to JOB_ALLOWLISTS["inbox"]/["finance"] in
# agents/constants.py.
GMAIL_MCP_URL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
